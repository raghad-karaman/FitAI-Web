@page
@using FitAI.Localization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<FitAIResource> L
@model FitAI.Web.Pages.Magazalar.IndexModel

<div class="fitai-page">

    <div class="page-header mb-4">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="page-icon">
                    <i class="fas fa-store"></i>
                </div>
                <div>
                    <h2 class="page-title mb-1">Mağaza Yönetimi</h2>
                    <p class="text-muted mb-0 small">Platforma kayıtlı tüm mağazaları yönetin</p>
                </div>
            </div>
            <button class="btn btn-primary" id="yeniMagazaBtn">
                <i class="fas fa-plus me-2"></i>Yeni Mağaza Ekle
            </button>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="magaza-kpi-card" data-card="total">
                <div class="magaza-kpi-icon"><i class="fas fa-store"></i></div>
                <div class="magaza-kpi-info">
                    <div class="magaza-kpi-value" id="kpiToplam">0</div>
                    <div class="magaza-kpi-label">Toplam Mağaza</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="magaza-kpi-card" data-card="active">
                <div class="magaza-kpi-icon"><i class="fas fa-check-circle"></i></div>
                <div class="magaza-kpi-info">
                    <div class="magaza-kpi-value" id="kpiAktif">0</div>
                    <div class="magaza-kpi-label">Aktif Mağaza</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="magaza-kpi-card" data-card="premium">
                <div class="magaza-kpi-icon"><i class="fas fa-crown"></i></div>
                <div class="magaza-kpi-info">
                    <div class="magaza-kpi-value" id="kpiPremium">0</div>
                    <div class="magaza-kpi-label">Premium Paket</div>
                </div>
            </div>
        </div>
    </div>

    <div class="filter-panel mb-4 p-3 bg-white border rounded">
        <div class="row g-3">
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="fas fa-search text-muted"></i></span>
                    <input type="text" class="form-control border-start-0 ps-0" id="aramaInput" placeholder="Mağaza adı veya e-posta ile ara...">
                </div>
            </div>
            <div class="col-md-3">
                <select class="form-select" id="paketFiltre">
                    <option value="">Tüm Paketler</option>
                    <option value="Baslangic">Başlangıç</option>
                    <option value="Standart">Standart</option>
                    <option value="Premium">Premium</option>
                </select>
            </div>
            <div class="col-md-3">
                <select class="form-select" id="durumFiltre">
                    <option value="">Tüm Durumlar</option>
                    <option value="aktif">Aktif</option>
                    <option value="pasif">Pasif</option>
                </select>
            </div>
            <div class="col-md-2">
                <button class="btn btn-light w-100 border text-dark" id="filtreTemizle">
                    <i class="fas fa-undo me-2"></i>Temizle
                </button>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="magazaTablosu">
                <thead class="bg-light text-secondary uppercase small fw-bold">
                    <tr>
                        <th class="ps-4 py-3" style="width: 35%;">Mağaza Bilgisi</th>
                        <th class="py-3" style="width: 20%;">Paket Türü</th>
                        <th class="py-3" style="width: 15%;">Komisyon Oranı</th>
                        <th class="py-3" style="width: 15%;">Durum</th>
                        <th class="pe-4 py-3 text-end" style="width: 15%;">Aksiyonlar</th>
                    </tr>
                </thead>
                <tbody id="magazaTableBody">
                    <tr>
                        <td colspan="5" class="text-center py-4 text-muted">
                            <i class="fas fa-spinner fa-spin me-2"></i>Mağazalar yükleniyor...
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="yeniMagazaModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-light border-0 py-3">
                <h5 class="modal-title fw-bold text-dark"><i class="fas fa-store-alt me-2 text-primary"></i>Yeni Mağaza Ekle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="yeniMagazaForm">
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Mağaza Adı</label>
                        <input type="text" class="form-control" id="magazaAdi" required placeholder="Ön. FitLife Studio">
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">E-posta Adresi</label>
                        <input type="email" class="form-control" id="magazaEposta" required placeholder="studio@fitlife.com">
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Başlangıç Şifresi</label>
                        <input type="password" class="form-control" id="magazaSifre" required placeholder="••••••••">
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Paket Türü</label>
                        <select class="form-select" id="magazaPaket" required>
                            <option value="">Seçiniz...</option>
                            <option value="Baslangic">Başlangıç</option>
                            <option value="Standart">Standart</option>
                            <option value="Premium">Premium</option>
                        </select>
                        <div class="paket-yardim form-text small text-primary mt-1"></div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Komisyon Oranı (%)</label>
                        <input type="number" class="form-control" id="magazaKomisyon" min="0" max="100" step="0.1" value="10">
                    </div>
                    <div class="form-check form-switch mt-4">
                        <input class="form-check-input" type="checkbox" id="magazaAktif" checked>
                        <label class="form-check-label small fw-bold" for="magazaAktif">Mağaza Aktif Olarak Başlasın</label>
                    </div>
                </div>
                <div class="modal-footer bg-light border-0 py-3">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save me-1"></i>Kaydet</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="editMagazaModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-light border-0 py-3">
                <h5 class="modal-title fw-bold text-dark"><i class="fas fa-edit me-2 text-primary"></i>Mağaza Düzenle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="editMagazaForm">
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Mağaza Adı</label>
                        <input type="text" class="form-control" id="editMagazaAdi" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">E-posta Adresi</label>
                        <input type="email" class="form-control" id="editMagazaEposta" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Paket Türü</label>
                        <select class="form-select" id="editMagazaPaket" required>
                            <option value="Baslangic">Başlangıç</option>
                            <option value="Standart">Standart</option>
                            <option value="Premium">Premium</option>
                        </select>
                        <div class="paket-yardim form-text small text-primary mt-1"></div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Komisyon Oranı (%)</label>
                        <input type="number" class="form-control" id="editMagazaKomisyon" min="0" max="100" step="0.1">
                    </div>
                    <div class="form-check form-switch mt-4">
                        <input class="form-check-input" type="checkbox" id="editMagazaAktif">
                        <label class="form-check-label small fw-bold" for="editMagazaAktif">Mağaza Aktif</label>
                    </div>
                </div>
                <div class="modal-footer bg-light border-0 py-3">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save me-1"></i>Değişiklikleri Kaydet</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="silOnayModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 shadow">
            <div class="modal-body text-center py-4">
                <div class="text-danger mb-3" style="font-size: 2.5rem;">
                    <i class="fas fa-exclamation-triangle"></i>
                </div>
                <h5 class="fw-bold mb-2">Mağazayı Sil</h5>
                <p class="text-muted small mb-0">
                    <strong id="silMagazaAdi" class="text-dark"></strong> mağazasını silmek istediğinize emin misiniz?
                </p>
            </div>
            <div class="modal-footer justify-content-center border-0 pt-0 bg-light py-3">
                <button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal">Vazgeç</button>
                <button type="button" class="btn btn-danger btn-sm" id="silOnayBtn">
                    <i class="fas fa-trash me-1"></i>Evet, Sil
                </button>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/client-proxies/app-proxy.js"></script>
    <script src="~/Pages/Magazalar/Index.js"></script>
}