<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>FitAI | @ViewData["Title"]</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { font-family: 'Inter', sans-serif; }
        .navbar-brand { font-weight: 700; font-size: 1.4rem; }
        .nav-link { font-weight: 500; }
        footer { font-size: 0.8rem; }
    </style>
    @await RenderSectionAsync("styles", required: false)
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-light bg-light">
        <div class="container">
            <a class="navbar-brand" href="/">
                <i class="fas fa-robot text-primary"></i> FitAI
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link" href="/">Dashboard</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Magazalar">Mağazalar</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Urunler/Liste">Ürünler</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Kullanicilar">Kullanıcılar</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Analiz">AI & Analiz</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Komisyonlar">Komisyonlar</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Talimatlar">Talimatlar</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Yorumlar">Yorumlar</a></li>
                </ul>
                <ul class="navbar-nav">
                    <li class="nav-item"><a class="nav-link" href="/Account/Logout">Çıkış</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <main class="container my-4">
        @RenderBody()
    </main>

    <footer class="text-muted text-center py-3 border-top">
        &copy; @DateTime.Now.Year FitAI - Yapay Zeka Destekli Kıyafet Uyum Platformu
    </footer>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    @await RenderSectionAsync("scripts", required: false)
</body>
</html>