@page
@model FitAI.Web.Pages.Bildirimler.IndexModel
@{
    ViewData["Title"] = "Bildirimler";
}

<div class="container-fluid py-4">

    <!-- Başlık -->
    <div class="row mb-3 align-items-center">
        <div class="col">
            <h4 class="mb-0">
                <i class="fa fa-bell me-2 text-primary"></i>Bildirimler
                <span id="okunmamisSayi" class="badge bg-danger ms-2 d-none"></span>
            </h4>
        </div>
        <div class="col-auto d-flex gap-2">
            <select id="kanalFiltre" class="form-select form-select-sm" style="width:auto">
                <option value="">Tüm Kanallar</option>
                <option value="InApp">Uygulama İçi</option>
                <option value="Email">E-posta</option>
                <option value="Push">Push</option>
            </select>
            <select id="tipFiltre" class="form-select form-select-sm" style="width:auto">
                <option value="">Tüm Tipler</option>
                <option value="AI">AI</option>
                <option value="Sistem">Sistem</option>
                <option value="Uyari">Uyarı</option>
            </select>
            <button id="btnTumunuOku" class="btn btn-outline-secondary btn-sm">
                <i class="fa fa-check-double me-1"></i>Tümünü Okundu İşaretle
            </button>
        </div>
    </div>

    <!-- Okundu/Okunmadı Sekmeleri -->
    <ul class="nav nav-tabs mb-3" id="bildirimTab">
        <li class="nav-item">
            <a class="nav-link active" data-filter="tumu" href="#">Tümü</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" data-filter="okunmamis" href="#">Okunmamış</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" data-filter="okunmus" href="#">Okunmuş</a>
        </li>
    </ul>

    <!-- Liste -->
    <div id="bildirimListesi" class="list-group shadow-sm"></div>

    <div id="yukleniyor" class="text-center py-5 text-muted d-none">
        <i class="fa fa-spinner fa-spin fa-2x"></i>
        <p class="mt-2">Yükleniyor...</p>
    </div>

    <div id="bosListeMesaji" class="text-center py-5 text-muted d-none">
        <i class="fa fa-bell-slash fa-3x mb-3"></i>
        <p>Gösterilecek bildirim yok.</p>
    </div>
</div>

<!-- Silme Onay Modal -->
<div class="modal fade" id="silmeModal" tabindex="-1">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Bildirimi Sil</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                Bu bildirimi silmek istediğinize emin misiniz?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">İptal</button>
                <button type="button" class="btn btn-danger btn-sm" id="btnSilmeOnayla">Sil</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="~/Pages/Bildirimler/Index.css" />
    <script src="~/Pages/Bildirimler/Index.js"></script>
}
